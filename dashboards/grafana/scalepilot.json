          "refId": "B",
          "expr": "max by(namespace,policy) (scalepilot_policy{namespace=~\"$namespace\",policy=~\"$policy\",measure=\"current\"})",
          "legendFormat": "{{policy}} replicas"
        }
      ]
    },
    {
