{
  "name": "ScalePilot Go toolchain",
  "init": true,
  "image": "golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea",
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "postCreateCommand": "bash scripts/bootstrap-tools.sh",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "ms-kubernetes-tools.vscode-kubernetes-tools"]
    }
  }
}
