# For Go worker/load generator commands outside Kubernetes only.
REDIS_ADDRESS=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_SERVER_NAME=
REDIS_CA_FILE=
REDIS_CERT_FILE=
REDIS_KEY_FILE=
# Optional operator tracing; no exporter is started when this is unset.
OTEL_EXPORTER_OTLP_ENDPOINT=
